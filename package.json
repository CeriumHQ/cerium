{
  "name": "cerium",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*"
  ],
  "type": "module",
  "scripts": {
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test",
    "typecheck": "tsc -b",
    "verify": "vp check && tsc -b && vp test --run",
    "vendor:effect": "node scripts/vendor-effect.ts",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "dev:ui": "vp -C apps/ui dev"
  },
  "devDependencies": {
    "@effect/tsgo": "0.53.3",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "bun@1.4.3"
}
