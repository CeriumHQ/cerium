{
  "name": "cerium",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*"
  ],
  "type": "module",
  "scripts": {
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test",
    "typecheck": "tsc -b",
    "build": "vp run -r build",
    "package": "vp run -r build && bun run --cwd apps/desktop package",
    "verify": "vp check && tsc -b && vp test --run",
    "vendor:effect": "node scripts/vendor-effect.ts",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "dev": "node scripts/dev.ts",
    "dev:ui": "vp -C apps/ui dev",
    "dev:web": "vp -C apps/ui dev --mode web",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "dev:backend": "node --watch apps/backend/src/main.ts --data-dir=.cerium-dev --connection-file=.cerium-dev/connection.json --relay-url=http://localhost:8787",
    "dev:relay": "bun run --cwd apps/relay dev",
    "ui": "node packages/browser/src/cli.ts",
    "live-check": "node apps/backend/scripts/live-check.ts"
  },
  "devDependencies": {
    "@effect/tsgo": "0.53.3",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "effect": "4.0.5",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "electron"
  ]
}
