// Cerium's relay. `bun run --cwd apps/relay dev` runs it locally with
// the Clerk keys in .dev.vars (see .dev.vars.example); `deploy` needs `wrangler login` first. It
// serves public/ and the web UI, which scripts/assets.ts puts together in dist/assets: one
// build per version, earlier releases' fetched by scripts/builds.ts. The release workflows deploy it
// before publishing each installer (.github/actions/deploy-relay).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cerium-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "routes": [{ "pattern": "cerium.nonlooped.xyz", "custom_domain": true }],
  "build": { "command": "node scripts/assets.ts", "watch_dir": "public" },
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNTS", "class_name": "Account" },
      { "name": "LINKS", "class_name": "Link" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Account", "Link"] }],
  // What src/limits.ts allows each client, per Cloudflare location. Each namespace_id is unique in
  // the Cloudflare account, so no other Worker shares these counters; a period changed here changes
  // in src/limits.ts too, which tells refused clients how long to wait.
  "ratelimits": [
    { "name": "SIGN_IN_LIMIT", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "PUBLIC_LIMIT", "namespace_id": "4102", "simple": { "limit": 30, "period": 10 } },
    { "name": "ADDRESS_LIMIT", "namespace_id": "4103", "simple": { "limit": 100, "period": 10 } },
    { "name": "DEVICE_LIMIT", "namespace_id": "4104", "simple": { "limit": 30, "period": 10 } },
    { "name": "CONNECT_LIMIT", "namespace_id": "4105", "simple": { "limit": 10, "period": 60 } },
  ],
  // The Account object's SQL migrations (migrations/migrations.js) are bundled as text.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "observability": { "enabled": true },
  "send_metrics": false,
  "vars": {
    "PUBLIC_ORIGIN": "https://cerium.nonlooped.xyz",
    // How push services reach whoever runs the relay; its VAPID keys are secrets.
    "VAPID_SUBJECT": "https://cerium.nonlooped.xyz",
  },
  "dev": { "port": 8787 },
}
