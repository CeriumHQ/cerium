{
  "name": "@cerium/host",
  "version": "0.0.0",
  "private": false,
  "description": "Run a Cerium host without the desktop app",
  "license": "Apache-2.0",
  "bin": {
    "cerium-host": "./bin/cerium-host.mjs"
  },
  "files": [
    "bin/cerium-host.mjs",
    "dist/",
    "migrations/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && node scripts/resources.ts",
    "build:npm": "bun run build && node scripts/npm.ts",
    "package": "bun run build && node scripts/package.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.302",
    "@anthropic-ai/sdk": "0.135.0",
    "@cursor/sdk": "1.0.38",
    "@effect/sql-sqlite-node": "4.0.5",
    "@fontsource-variable/red-hat-mono": "5.3.0",
    "@fontsource-variable/red-hat-text": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@muse-code/sdk": "1.4.8",
    "@opencode/client": "2.0.32",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.0.5",
    "ignore": "7.0.14",
    "jsonc-parser": "3.3.1",
    "node-pty": "1.2.0-beta.15",
    "parse5": "8.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "toml-eslint-parser": "1.0.3",
    "undici": "8.12.2",
    "unified": "11.0.5",
    "vscode-jsonrpc": "10.0.0",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cerium/account": "workspace:*",
    "@cerium/backend": "workspace:*",
    "@cerium/protocol": "workspace:*",
    "@cerium/rpc": "workspace:*",
    "@effect/platform-node": "4.0.5"
  },
  "bundleDependencies": [
    "node-pty"
  ],
  "engines": {
    "node": ">=24.11.0"
  }
}
