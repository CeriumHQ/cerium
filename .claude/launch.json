{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev", "--browser"],
      "port": 5173
    },
    {
      "name": "bench",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--cwd", "apps/ui", "vp", "preview", "-c", "scratch/vite.bench.ts"],
      "port": 5199
    },
    {
      "name": "ui",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev:ui"],
      "port": 5173
    },
    {
      "name": "ui-review",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--cwd", "apps/ui", "vp", "dev", "-c", "scratch/vite.review.ts"],
      "port": 5180,
      "autoPort": false
    },
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev:web"],
      "env": { "CERIUM_RELAY": "http://localhost:8788" },
      "port": 5174
    },
    {
      "name": "relay",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev:relay"],
      "port": 8787
    }
  ]
}
